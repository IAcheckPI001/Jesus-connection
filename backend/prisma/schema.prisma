generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ban {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_ban             String               @unique @db.VarChar
  ten_ban            String               @db.VarChar
  ngay_tao           DateTime             @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime             @default(now()) @db.Timestamptz(6)
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
}

model buoi_sinh_hoat {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_chi_doan        String             @db.Uuid
  ngay_sinh_hoat     DateTime           @db.Date
  chu_de             String?            @db.VarChar
  ngay_tao           DateTime           @default(now()) @db.Timestamptz(6)
  trang_thai_lop_hoc trang_thai_lop_hoc @default(chuan_bi)
  chi_doan           chi_doan           @relation(fields: [id_chi_doan], references: [id], onUpdate: NoAction, map: "buoi_sinh_hoat_chi_doan_id_fkey")
  diem_danh          diem_danh[]
}

model chi_doan {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_chi_doan        String               @unique @db.VarChar
  ten_chi_doan       String               @db.VarChar
  id_nganh           String               @db.Uuid
  ngay_tao           DateTime             @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime             @default(now()) @db.Timestamptz(6)
  buoi_sinh_hoat     buoi_sinh_hoat[]
  nganh              nganh                @relation(fields: [id_nganh], references: [id], onUpdate: NoAction, map: "fk_chidoan_nganh")
  doi_nhom           doi_nhom[]
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
  thieu_nhi          thieu_nhi[]
}

model diem_danh {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_buoi_sinh_hoat String               @db.Uuid
  id_thieu_nhi      String               @unique(map: "diem_danh_id_doan_sinh_key") @map("id_doan_sinh") @db.Uuid
  thoi_gian_quet    DateTime             @default(now()) @db.Timestamptz(6)
  trang_thai        trang_thai_tham_gia?
  buoi_sinh_hoat    buoi_sinh_hoat       @relation(fields: [id_buoi_sinh_hoat], references: [id], onUpdate: NoAction, map: "diem_danh_buoi_sinh_hoat_id_fkey")
  thieu_nhi         thieu_nhi            @relation(fields: [id_thieu_nhi], references: [id], onUpdate: NoAction, map: "diem_danh_doan_sinh_id_fkey")

  @@unique([id_buoi_sinh_hoat, id_thieu_nhi], map: "diem_danh_buoi_sinh_hoat_id_doan_sinh_id_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doi_nhom {
  id                                          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ten_doi                                     String?     @db.VarChar
  id_chi_doan                                 String      @db.Uuid
  id_doi_truong                               String?     @db.Uuid
  ngay_tao                                    DateTime    @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat                               DateTime    @default(now()) @db.Timestamptz(6)
  ma_doi                                      String      @db.VarChar
  chi_doan                                    chi_doan    @relation(fields: [id_chi_doan], references: [id], onUpdate: NoAction, map: "doi_nhom_chi_doan_id_fkey")
  doan_sinh_doi_nhom_id_doi_truongTodoan_sinh thieu_nhi?  @relation("doi_nhom_id_doi_truongTodoan_sinh", fields: [id_doi_truong], references: [id], onUpdate: NoAction, map: "fk_doinhom_doitruong")
  thieu_nhi_thieu_nhi_id_doi_nhomTodoi_nhom   thieu_nhi[] @relation("thieu_nhi_id_doi_nhomTodoi_nhom")

  @@unique([id_chi_doan, ten_doi], map: "doi_nhom_chi_doan_id_ten_doi_key")
}

model nganh {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_nganh           String               @unique @db.VarChar
  ten_nganh          String               @db.VarChar
  ngay_tao           DateTime             @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime             @default(now()) @db.Timestamptz(6)
  thu_tu             Int                  @db.SmallInt
  khau_hieu          String?              @db.VarChar
  chi_doan           chi_doan[]
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
}

model nhan_su {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_nhan_su         String                    @unique @db.VarChar
  loai_nhan_su       loai_nhan_su_enum
  id_thieu_nhi_goc   String?                   @map("id_doan_sinh_goc") @db.Uuid
  ten_thanh          String?                   @db.VarChar
  ho_ten             String                    @db.VarChar
  ngay_sinh          DateTime?                 @db.Date
  gioi_tinh          gioi_tinh_enum
  so_dien_thoai      String?                   @db.VarChar
  dia_chi            String?                   @db.VarChar
  trang_thai         trang_thai_sinh_hoat_enum @default(dang_sinh_hoat)
  ngay_tao           DateTime                  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime                  @default(now()) @db.Timestamptz(6)
  id_tai_khoan       String?                   @unique @db.Uuid
  tai_khoan          tai_khoan?                @relation(fields: [id_tai_khoan], references: [id], onUpdate: NoAction, map: "nhan_su_id_tai_khoan_fkey1")
  thieu_nhi          thieu_nhi?                @relation(fields: [id_thieu_nhi_goc], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_nhansu_doansinhgoc")
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nien_khoa {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_nien_khoa       String                    @unique @db.VarChar
  ngay_bat_dau       DateTime?                 @db.Date
  ngay_ket_thuc      DateTime?                 @db.Date
  chu_de             String?                   @db.VarChar
  ngay_tao           DateTime                  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime                  @default(now()) @db.Timestamptz(6)
  trang_thai         trang_thai_nien_khoa_enum @unique(map: "idx_nien_khoa_chi_mot_dang_dien_ra", where: raw("(trang_thai = 'dang_dien_ra'::trang_thai_nien_khoa_enum)")) @default(sap_dien_ra)
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model phan_cong_nhiem_vu {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_nhan_su    String                    @db.Uuid
  id_vai_tro    String                    @db.Uuid
  id_nien_khoa  String                    @db.Uuid
  pham_vi       pham_vi_enum
  id_nganh      String?                   @db.Uuid
  id_chi_doan   String?                   @db.Uuid
  id_ban        String?                   @db.Uuid
  trang_thai    trang_thai_phan_cong_enum @default(dang_phan_cong)
  ghi_chu       String?                   @db.VarChar
  ngay_tao      DateTime                  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat DateTime                  @default(now()) @db.Timestamptz(6)
  ban           ban?                      @relation(fields: [id_ban], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "phan_cong_nhiem_vu_ban_id_fkey")
  chi_doan      chi_doan?                 @relation(fields: [id_chi_doan], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "phan_cong_nhiem_vu_chi_doan_id_fkey")
  nganh         nganh?                    @relation(fields: [id_nganh], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "phan_cong_nhiem_vu_nganh_id_fkey")
  nhan_su       nhan_su                   @relation(fields: [id_nhan_su], references: [id], onUpdate: NoAction, map: "phan_cong_nhiem_vu_nhan_su_id_fkey")
  nien_khoa     nien_khoa                 @relation(fields: [id_nien_khoa], references: [id], onUpdate: NoAction, map: "phan_cong_nhiem_vu_nien_khoa_id_fkey")
  vai_tro       vai_tro                   @relation(fields: [id_vai_tro], references: [id], onUpdate: NoAction, map: "phan_cong_nhiem_vu_vai_tro_id_fkey")

  @@unique([id_nhan_su, id_vai_tro, id_nien_khoa, id_ban], map: "uq_phancong_ban", where: raw("(pham_vi = 'ban'::pham_vi_enum)"))
  @@unique([id_nhan_su, id_vai_tro, id_nien_khoa, id_chi_doan], map: "uq_phancong_chidoan", where: raw("(pham_vi = 'chi_doan'::pham_vi_enum)"))
  @@unique([id_nhan_su, id_vai_tro, id_nien_khoa, id_nganh], map: "uq_phancong_nganh", where: raw("(pham_vi = 'nganh'::pham_vi_enum)"))
  @@unique([id_nhan_su, id_vai_tro, id_nien_khoa], map: "uq_phancong_xudoan", where: raw("(pham_vi = 'xu_doan'::pham_vi_enum)"))
}

model phu_huynh {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_phu_huynh        String                    @unique @db.VarChar
  ten_thanh           String?                   @db.VarChar
  ho_ten              String                    @db.VarChar
  gioi_tinh           gioi_tinh_enum
  so_dien_thoai       String                    @db.VarChar
  dia_chi             String?                   @db.VarChar
  trang_thai          trang_thai_phu_huynh_enum @default(dang_hoat_dong)
  ngay_tao            DateTime                  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat       DateTime                  @default(now()) @db.Timestamptz(6)
  id_tai_khoan        String?                   @unique @db.Uuid
  tai_khoan           tai_khoan?                @relation(fields: [id_tai_khoan], references: [id], onUpdate: NoAction, map: "phu_huynh_id_tai_khoan_fkey1")
  thieu_nhi_phu_huynh thieu_nhi_phu_huynh[]
}

model tai_khoan {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ten_tai_khoan   String            @unique(map: "tai_khoan_so_dien_thoai_key")
  mat_khau        String
  ngay_khoi_tao   DateTime          @default(now()) @db.Timestamptz(6)
  nhan_su         nhan_su?
  phien_dang_nhap phien_dang_nhap[]
  phu_huynh       phu_huynh?

  @@index([ten_tai_khoan], map: "idx_users_phone")
}

model vai_tro {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_vai_tro         String               @unique @db.VarChar
  ten_vai_tro        String               @db.VarChar
  ngay_tao           DateTime             @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat      DateTime             @default(now()) @db.Timestamptz(6)
  phan_cong_nhiem_vu phan_cong_nhiem_vu[]
  vai_tro_pham_vi    vai_tro_pham_vi[]
}

model vai_tro_pham_vi {
  id_vai_tro String       @db.Uuid
  pham_vi    pham_vi_enum
  vai_tro    vai_tro      @relation(fields: [id_vai_tro], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_vai_tro, pham_vi])
}

model phien_dang_nhap {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_phien       String    @unique
  tai_khoan_id   String    @db.Uuid
  ten_thiet_bi   String?
  dia_chi_ip     String?
  ngay_dang_nhap DateTime  @default(now()) @db.Timestamptz(6)
  truy_cap_cuoi  DateTime  @default(now()) @db.Timestamptz(6)
  ngay_het_han   DateTime  @db.Timestamptz(6)
  tai_khoan      tai_khoan @relation(fields: [tai_khoan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tai_khoan_id], map: "idx_sessions_tai_khoan")
  @@index([ma_phien], map: "idx_sessions_token")
}

model thieu_nhi {
  id                                         String                    @id(map: "doan_sinh_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_thieu_nhi                               String                    @unique(map: "doan_sinh_ma_doan_sinh_key") @map("ma_doan_sinh") @db.VarChar
  id_chi_doan                                String?                   @db.Uuid
  ten_thanh                                  String?                   @db.VarChar
  ho                                         String                    @db.VarChar
  ngay_sinh                                  DateTime                  @db.Date
  gioi_tinh                                  gioi_tinh_enum
  so_dien_thoai                              String?                   @db.VarChar
  dia_chi                                    String?                   @db.VarChar
  trang_thai                                 trang_thai_sinh_hoat_enum @default(dang_sinh_hoat)
  ngay_tao                                   DateTime                  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat                              DateTime                  @default(now()) @db.Timestamptz(6)
  id_doi_nhom                                String?                   @db.Uuid
  ten                                        String                    @db.VarChar
  qr_token_hash                              String?                   @unique(map: "doan_sinh_qr_token_hash_key") @db.VarChar
  diem_danh                                  diem_danh?
  doi_nhom_doi_nhom_id_doi_truongTodoan_sinh doi_nhom[]                @relation("doi_nhom_id_doi_truongTodoan_sinh")
  nhan_su                                    nhan_su[]
  chi_doan                                   chi_doan?                 @relation(fields: [id_chi_doan], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_doansinh_chidoan")
  doi_nhom_thieu_nhi_id_doi_nhomTodoi_nhom   doi_nhom?                 @relation("thieu_nhi_id_doi_nhomTodoi_nhom", fields: [id_doi_nhom], references: [id], onUpdate: NoAction, map: "fk_doansinh_doinhom")
  thieu_nhi_phu_huynh                        thieu_nhi_phu_huynh[]

  @@map("doan_sinh")
}

model thieu_nhi_phu_huynh {
  id               String           @id(map: "doan_sinh_phu_huynh_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_thieu_nhi     String           @map("id_doan_sinh") @db.Uuid
  id_phu_huynh     String           @db.Uuid
  moi_quan_he      moi_quan_he_enum
  is_lien_he_chinh Boolean          @default(false)
  ngay_tao         DateTime         @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat    DateTime         @default(now()) @db.Timestamptz(6)
  phu_huynh        phu_huynh        @relation(fields: [id_phu_huynh], references: [id], onUpdate: NoAction, map: "doan_sinh_phu_huynh_id_phu_huynh_fkey")
  thieu_nhi        thieu_nhi        @relation(fields: [id_thieu_nhi], references: [id], onUpdate: NoAction, map: "doan_sinh_phu_huynh_id_doan_sinh_fkey")

  @@unique([id_thieu_nhi, id_phu_huynh], map: "doan_sinh_phu_huynh_id_doan_sinh_id_phu_huynh_key")
  @@map("doan_sinh_phu_huynh")
}

